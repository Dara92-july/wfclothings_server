# Server environment template (copy to .env and fill in real values)
# Copy: cp .env.example .env

# App
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Auth / JWT
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRE=7d

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
PAYSTACK_WEBHOOK_SECRET=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (transactional email)
RESEND_API_KEY=re_xxx
FROM_EMAIL=noreply@wfclothings.net
FROM_NAME=WF Clothings

# Frontend (for CORS + Paystack callback_url)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Admin seed (used by utils/seeder.js)
ADMIN_EMAIL=admin@wfclothings.net
ADMIN_PASSWORD=strong_password
ADMIN_PHONE=+2348000000000
ADMIN_URL=https://wfclothings.net/admin
